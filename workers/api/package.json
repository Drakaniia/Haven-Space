{
  "name": "@haven-space/cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8000",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "migrate:local": "wrangler d1 migrations apply haven-space --local",
    "migrate:remote": "wrangler d1 migrations apply haven-space --remote",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.8.12",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250803.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.26.1"
  }
}
